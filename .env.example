# Optional backend port.
BACKEND_PORT=8000

# Required to use the OpenRouter argument normalizer.
# OPENROUTER_API_KEY=your_openrouter_key
# Optional Dots 3-compatible OpenRouter model override.
# OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free

# Optional database locations. Defaults use the packaged synthetic baseline and a temp runtime directory.
# CUE_DEMO_SEED_DB=/opt/cue/share/cue_demo.db
# CUE_DEMO_RUNTIME_DIR=/tmp/cue-demo-runtime
