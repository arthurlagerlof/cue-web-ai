# Server-side only. Used by the Vite middleware and Netlify OpenRouter function.
# OPENROUTER_API_KEY=your_openrouter_key
# Optional OpenRouter model override (defaults to openrouter/free).
# OPENROUTER_MODEL=openrouter/free

# Optional server-side Supabase connection for Netlify Dev / global statistics.
# DATABASE_URL=postgresql://...
